+    private static boolean matchesAnyAscii(final byte[] buf, final int start, final int end, final byte[][] patterns) {
+        final int span = end - start;
+        for (final byte[] pattern : patterns) {
+            if (span >= pattern.length && containsAscii(buf, start, end, pattern)) {
+                return true;
+            }
+        }
+        return false;
+    }
