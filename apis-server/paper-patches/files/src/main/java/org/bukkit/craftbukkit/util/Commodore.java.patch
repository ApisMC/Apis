+    private static boolean containsAscii(final byte[] buf, final int start, final int end, final byte[] needle) {
+        final byte first = needle[0];
+        final int maxStart = end - needle.length;
+        for (int i = start; i <= maxStart; i++) {
+            if (buf[i] != first) {
+                continue;
+            }
+            boolean matched = true;
+            for (int j = 1; j < needle.length; j++) {
+                if (buf[i + j] != needle[j]) {
+                    matched = false;
+                    break;
+                }
+            }
+            if (matched) {
+                return true;
+            }
+        }
+        return false;
+    }
 
