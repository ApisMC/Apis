+    /**
+     * Checks once per lifecycle whether {@code addons/update/} contains any regular files
+     * so plugin discovery skips redundant JAR opens when the update directory is empty.
+     *
+     * @return {@code true} if update files may exist or checking fails
+     */
+    public boolean hasPendingUpdateFiles() { // Apis
+        final Boolean cached = this.hasPendingUpdates;
+        if (cached != null) {
+            return cached;
+        }
+        if (this.updateDirectory == null || !Files.isDirectory(this.updateDirectory)) {
+            this.hasPendingUpdates = Boolean.FALSE;
+            return false;
+        }
+        boolean found;
+        try (java.util.stream.Stream<Path> entries = Files.list(this.updateDirectory)) {
+            found = entries.anyMatch(Files::isRegularFile);
+        } catch (final IOException ignored) {
+            return true;
+        }
+        this.hasPendingUpdates = found;
+        return found;
+    }
