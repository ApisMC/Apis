+    public static boolean mayNeedRewrite(final byte[] bytes) {
+        if (bytes.length < 10) {
+            return true;
+        }
+        final int cpCount = ((bytes[8] & 0xFF) << 8) | (bytes[9] & 0xFF);
+        int pos = 10;
+        for (int i = 1; i < cpCount; i++) {
+            if (pos >= bytes.length) {
+                return true;
+            }
+            final int tag = bytes[pos++] & 0xFF;
+            switch (tag) {
+                case 1 -> {
+                    if (pos + 2 > bytes.length) {
+                        return true;
+                    }
+                    final int len = ((bytes[pos] & 0xFF) << 8) | (bytes[pos + 1] & 0xFF);
+                    pos += 2;
+                    if (pos + len > bytes.length) {
+                        return true;
+                    }
+                    final int end = pos + len;
+                    for (final byte[] target : REFLECTION_CONSTANT_POOL_TARGETS) {
+                        if (end - pos >= target.length && containsAscii(bytes, pos, end, target)) {
+                            return true;
+                        }
+                    }
+                    pos = end;
+                }
+                case 3, 4, 9, 10, 11, 12, 17, 18 -> pos += 4;
+                case 5, 6 -> {
+                    pos += 8;
+                    i++;
+                }
+                case 7, 8, 16, 19, 20 -> pos += 2;
+                case 15 -> pos += 3;
+                default -> {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private static boolean containsAscii(final byte[] buf, final int start, final int end, final byte[] needle) {
+        final byte first = needle[0];
+        final int maxStart = end - needle.length;
+        for (int i = start; i <= maxStart; i++) {
+            if (buf[i] != first) {
+                continue;
+            }
+            boolean matched = true;
+            for (int j = 1; j < needle.length; j++) {
+                if (buf[i + j] != needle[j]) {
+                    matched = false;
+                    break;
+                }
+            }
+            if (matched) {
+                return true;
+            }
+        }
+        return false;
+    }
