+fun buildLibraryClassPath(
+    resolvedArtifacts: Provider<Set<ResolvedArtifactResult>>,
+    apiGroup: String,
+    apiName: String,
+    apiVersion: String,
+): Provider<String> = resolvedArtifacts.map { artifacts ->
+    artifacts.asSequence()
+        .filter { it.file.extension == "jar" }
+        .mapNotNull { artifact ->
+            val fileName = artifact.file.name
+            when (val owner = artifact.variant.owner) {
+                is ModuleComponentIdentifier -> {
+                    "../../libraries/${owner.group.replace('.', '/')}/${owner.module}/${owner.version}/$fileName"
+                }
+                is ProjectComponentIdentifier -> {
+                    if (owner.projectPath == ":apis-api") {
+                        "../../libraries/${apiGroup.replace('.', '/')}/$apiName/$apiVersion/$fileName"
+                    } else {
+                        null
+                    }
+                }
+                else -> null
+            }
+        }
+        .distinct()
+        .sorted()
+        .joinToString(" ")
+}
