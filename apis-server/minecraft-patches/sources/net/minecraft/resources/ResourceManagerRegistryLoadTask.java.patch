+                if (reason != null) {
+                    skipped.put(entry.key().identifier(), reason);
+                    continue;
+                }
+                kept.add(entry);
+            } else {
+                parsedOk.add(entry);
+            }
+        }
+        boolean changed = !skipped.isEmpty();
+        while (changed) {
+            changed = false;
+            final java.util.Iterator<RegistryLoadTask.PendingRegistration<T>> it = parsedOk.iterator();
+            while (it.hasNext()) {
+                final RegistryLoadTask.PendingRegistration<T> entry = it.next();
+                final net.minecraft.advancements.Advancement advancement =
+                    (net.minecraft.advancements.Advancement)entry.value().left().orElseThrow();
+                if (advancement.parent().isPresent() && skipped.containsKey(advancement.parent().get())) {
+                    skipped.put(entry.key().identifier(), skipped.get(advancement.parent().get()));
+                    it.remove();
+                    changed = true;
+                }
+            }
+        }
+        kept.addAll(parsedOk);
+        kept.sort(java.util.Comparator.comparing(entry -> entry.key().identifier()));
+        org.apismc.apis.hooks.ApisHooks.warnSkippedAdvancements(skipped);
+        return kept.stream();
     }
