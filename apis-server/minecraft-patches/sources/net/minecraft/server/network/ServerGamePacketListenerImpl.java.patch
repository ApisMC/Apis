+    private void updateLastEventPosIfMoved(
+        final double targetX,
+        final double targetY,
+        final double targetZ,
+        final float targetYRot,
+        final float targetXRot
+    ) {
+        double delta = Mth.square(this.lastPosX - targetX) + Mth.square(this.lastPosY - targetY) + Mth.square(this.lastPosZ - targetZ);
+        float deltaAngle = Math.abs(Mth.wrapDegrees(this.lastYRot - targetYRot)) + Math.abs(this.lastXRot - targetXRot);
+        if ((delta > 1.0F / 256 || deltaAngle > 10.0F) && !this.player.isImmobile()) {
+            this.lastPosX = targetX;
+            this.lastPosY = targetY;
+            this.lastPosZ = targetZ;
+            this.lastYRot = targetYRot;
+            this.lastXRot = targetXRot;
+        }
+    }
